# Dockerfile pour l'image personnalisée "lyonflow-ray"
# Cette image intègre Ray ainsi que tout l'éco-système de Deep Learning (PyTorch, PyG) 
# et de base de données nécessaire pour l'entraînement du modèle STGCN sur GPU.

FROM rayproject/ray:2.35.0-py312

# Passage en root pour installer d'éventuelles dépendances système légères
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Retour à l'utilisateur non-privilégié 'ray' (UID 1000)
USER 1000

# Mettre à jour pip
RUN pip install --no-cache-dir --upgrade pip

# Installation des dépendances classiques de données et tracking
RUN pip install --no-cache-dir \
    numpy \
    pandas \
    sqlalchemy \
    psycopg2-binary \
    scikit-learn \
    mlflow \
    matplotlib \
    optuna \
    optuna-dashboard \
    evidently \
    "pydantic>=1.10.17"

# Installation de PyTorch avec support CUDA 12.1 (compatible avec votre pilote hôte CUDA 12.8)
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu121

# Installation de PyTorch Geometric pour les convolutions de graphes
RUN pip install --no-cache-dir torch-geometric
